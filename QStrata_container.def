Bootstrap: docker
From: nvidia/cuda:12.4.1-runtime-ubuntu22.04

%environment
    export PATH="/.venv/bin:$PATH"
    export PYTHONUNBUFFERED=1
    export XLA_PYTHON_CLIENT_PREALLOCATE="false"

%post
    export DEBIAN_FRONTEND=noninteractive

    # 1. System essentials, compilers, and image processing headers
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        curl \
        python3 \
        python3-pip \
        python3-venv \
        python3-dev \
        libgomp1 \
        libgl1-mesa-glx \
        libglib2.0-0 \
        && rm -rf /var/lib/apt/lists/*

    # 2. Virtual environment setup
    python3 -m venv /.venv
    . /.venv/bin/activate
    pip install --no-cache-dir --upgrade pip setuptools wheel

    # 3. PyTorch with CUDA 12.4 support (Explicitly included for ResNet-18)
    pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124

    # 4. JAX with CUDA 12 support (For vectorized quantum layers)
    pip install --no-cache-dir -U "jax[cuda12]"

    # 5. Quantum simulation and computer vision packages
    pip install --no-cache-dir \
        mrmustard \
        timm \
        scikit-learn \
        scipy \
        h5py \
        matplotlib \
        pandas \
        pillow \
        tqdm \
        opencv-python-headless \
        pydicom \
        seaborn \
        joblib

%runscript
    exec python3 "$@"

%labels
    Version "1.1"
    Description "CVQNN & ResNet-18 Medical Imaging Environment with PyTorch, JAX, and Mr Mustard"