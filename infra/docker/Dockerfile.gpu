FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

# GPU-enabled PyTorch — pinned to CUDA 12.1 wheel
RUN pip3 install --no-cache-dir \
        torch==2.2.2+cu121 \
        torchvision==0.17.2+cu121 \
        --index-url https://download.pytorch.org/whl/cu121

# Project dependencies for GPU training scripts
# numpy<2 required: torch==2.2.2+cu121 was compiled against NumPy 1.x ABI
RUN pip3 install --no-cache-dir \
        "numpy<2" \
        medmnist \
        jupyterlab \
        matplotlib \
        scikit-learn \
        pyyaml

# DICOM reading support for VinDr-SpineXR (JPEG 2000 compressed files)
RUN pip3 install --no-cache-dir \
        pydicom \
        pylibjpeg \
        pylibjpeg-openjpeg

WORKDIR /workspace
